{
  "schema_version": 1,
  "skill": "ecommerce-product-image-studio",
  "purpose": "Machine-readable intake contract for e-commerce product visual production.",
  "principles": {
    "intent_fields": "user_explicit_only",
    "product_evidence": "inspect_authoritative_assets",
    "unknowns": "preserve_unknown",
    "optional_fields": "omit_when_unspecified",
    "attachment_rule": "product images must be inspected for product evidence, but must not be used to infer user intent such as platform, language, ratio, market, style, or requested deliverables"
  },
  "fields": [
    {
      "key": "product_images",
      "label_en": "Product images",
      "label_zh": "商品图片",
      "type": "file_upload",
      "file_types": [
        "image"
      ],
      "required": true,
      "maxCount": 10,
      "source_policy": "uploaded_attachment",
      "content_policy": "MUST inspect after intake for product evidence and identity lock"
    },
    {
      "key": "sku",
      "label_en": "SKU / product identifier",
      "label_zh": "SKU / 商品标识",
      "type": "text",
      "required": false,
      "source_policy": "user_explicit_or_verified_document"
    },
    {
